{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "狼人杀-AgentFramework",
  "version": "0.1.0",
  "identifier": "com.kukisama.langrensha",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "🐺 狼人杀 — Agent Framework Demo",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
